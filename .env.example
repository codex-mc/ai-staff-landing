# Required
ANTHROPIC_API_KEY=sk-ant-...

# CORS — set to landing page origin in production (e.g. https://aistaff.com.br)
# Leave empty in local dev to allow any origin.
LANDING_ORIGIN=https://aistaff.com.br

# Rate limiting (production) — Upstash Redis
# Get from https://console.upstash.com
# If not set, falls back to in-process Map (dev only, not suitable for multi-instance)
UPSTASH_REDIS_REST_URL=https://YOUR_URL.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN
